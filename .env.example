# Copy to .env and adjust. Both docker-compose and the Python tooling read this file.

# --- PostgreSQL (operational source system) ---
POSTGRES_DB=adtech
POSTGRES_USER=adtech
POSTGRES_PASSWORD=adtech
POSTGRES_HOST=localhost
# Host port mapping. Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# --- Data generation ---
# Dataset size profile defined in config/scales.yml: tiny | small | medium | large
ADTECH_SCALE=small
# Master random seed. The same seed always reproduces the same ecosystem.
ADTECH_SEED=42

# --- Object storage / Bronze layer ---
# MinIO stands in for S3 locally. Host ports are non-default because 9000/9001
# are commonly already taken by another project's object store.
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=adtech
S3_SECRET_KEY=adtechadtech
S3_REGION=us-east-1
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
BRONZE_BUCKET=adtech-bronze
# How often the always-on bronze-sink container writes a Parquet file. Every
# flush emits one object per table/day/partition, so a short interval means
# many tiny files. See docs/bronze.md.
BRONZE_FLUSH_SECONDS=900

# --- Continuous change traffic (optional, `make traffic-up`) ---
# How often the traffic container applies a batch, and how big each batch is.
# The defaults are a deliberate trickle: dimension tables in a real platform
# change at human rates, not machine ones.
TRAFFIC_INTERVAL_SECONDS=60
TRAFFIC_CHANGES_PER_BATCH=20

# --- Snowflake (phases 9-13) ---
# The only part of this project that is not local. Leave these blank and the
# lakehouse path through phase 8 still runs end to end; the warehouse targets
# then say so rather than failing with an authentication error.
#
# Account is the identifier, not the URL: ORGNAME-ACCOUNTNAME, or the older
# xy12345.region.cloud form. Find it under Admin -> Accounts in Snowsight.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Key-pair is the path that keeps working: Snowflake blocks password-only
# sign-in for programmatic users unless an authentication policy allows it.
# Generate with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/.snowflake/adtech_key.p8 -nocrypt
#   openssl rsa -in ~/.snowflake/adtech_key.p8 -pubout -out ~/.snowflake/adtech_key.pub
# then register the public key on the user with ALTER USER ... SET RSA_PUBLIC_KEY.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Only used when no private key is set.
SNOWFLAKE_PASSWORD=
# Created by `make warehouse-bootstrap`. Override only to reuse existing objects.
SNOWFLAKE_ROLE=ADTECH_ENGINEER
SNOWFLAKE_WAREHOUSE=ADTECH_WH
SNOWFLAKE_DATABASE=ADTECH
SNOWFLAKE_SCHEMA=RAW
