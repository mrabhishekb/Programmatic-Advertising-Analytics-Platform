# Copy to .env and adjust. Both docker-compose and the Python tooling read this file.

# --- PostgreSQL (operational source system) ---
POSTGRES_DB=adtech
POSTGRES_USER=adtech
POSTGRES_PASSWORD=adtech
POSTGRES_HOST=localhost
# Host port mapping. Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# --- Data generation ---
# Dataset size profile defined in config/scales.yml: tiny | small | medium | large
ADTECH_SCALE=small
# Master random seed. The same seed always reproduces the same ecosystem.
ADTECH_SEED=42
