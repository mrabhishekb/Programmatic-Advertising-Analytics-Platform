# Copy to .env and adjust. Both docker-compose and the Python tooling read this file.

# --- PostgreSQL (operational source system) ---
POSTGRES_DB=adtech
POSTGRES_USER=adtech
POSTGRES_PASSWORD=adtech
POSTGRES_HOST=localhost
# Host port mapping. Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# --- Data generation ---
# Dataset size profile defined in config/scales.yml: tiny | small | medium | large
ADTECH_SCALE=small
# Master random seed. The same seed always reproduces the same ecosystem.
ADTECH_SEED=42

# --- Continuous change traffic (optional, `make traffic-up`) ---
# How often the traffic container applies a batch, and how big each batch is.
# The defaults are a deliberate trickle: dimension tables in a real platform
# change at human rates, not machine ones.
TRAFFIC_INTERVAL_SECONDS=60
TRAFFIC_CHANGES_PER_BATCH=20
